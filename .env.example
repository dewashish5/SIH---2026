# ==========================================
# SkillGap Intelligence - Environment Config
# ==========================================

# Ports
PORT_GATEWAY=4000
PORT_API=8000
PORT_WEB=5173

# URLs
GATEWAY_URL=http://localhost:4000
API_URL=http://localhost:8000
WEB_URL=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skillgap
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/skillgap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skillgap
POSTGRES_PORT=5432

# Data source toggle: 'mock' | 'postgres'
DATA_SOURCE=mock

# JWT Auth Secret
JWT_SECRET=super-secret-skillgap-jwt-key-sih-2026-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=super-secret-refresh-key-sih-2026-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Alerts / Notification Config (Mock / SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=alerts@skillgap.gov.in
WHATSAPP_ENABLED=false

# LLM Grounded Assistant (Comma-separated keys for auto-fallback)
GEMINI_API_KEY=key1,key2,key3
GROQ_API_KEY=key1,key2,key3
# optional overrides
# WMSA_GEMINI_MODEL=gemini-3.8-flash
# WMSA_GROQ_MODEL=openai/gpt-oss-120b

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=skillgap123
NEO4J_DATABASE=neo4j

